{
  "manifest_version": "0.2",
  "name": "toss-readonly",
  "display_name": "토스증권 (조회 전용)",
  "version": "0.2.1",
  "description": "토스증권 Open API 조회 전용 MCP. 시장 전체 투자자별 매매대금, 지수·국고채, 투자자별·주식·섹터 랭킹, 종목 현재가·캔들·투자자 동향·공매도·프로그램매매, 환율. 주문·계좌 기능 없음.",
  "author": { "name": "hyunghopark" },
  "server": {
    "type": "node",
    "entry_point": "server/index.js",
    "mcp_config": {
      "command": "node",
      "args": [
        "${__dirname}/server/index.js"
      ],
      "env": {
        "TOSS_CLIENT_ID": "${user_config.client_id}",
        "TOSS_CLIENT_SECRET": "${user_config.client_secret}",
        "TOSS_MCP_LOG_FILE": "${HOME}/.toss-mcp/server.log"
      }
    }
  },
  "tools": [
    {
      "name": "toss_market_investor_trading",
      "description": "코스피·코스닥 시장 전체 투자자별 매매대금(순매수 억원 요약)"
    },
    {
      "name": "toss_market_indicator_prices",
      "description": "국내 지수·국고채 금리 현재가"
    },
    {
      "name": "toss_market_indicator_candles",
      "description": "국내 지수·국고채 금리 캔들"
    },
    {
      "name": "toss_investor_trading_rankings",
      "description": "투자자별 순매수·순매도 상위 종목"
    },
    {
      "name": "toss_stock_investor_trading",
      "description": "종목별 투자자 매매동향(주 수 기준)"
    },
    {
      "name": "toss_exchange_rate",
      "description": "원/달러 참고 환율"
    },
    {
      "name": "toss_kr_market_calendar",
      "description": "국내 장 운영 정보"
    },
    {
      "name": "toss_stock_short_selling",
      "description": "종목 공매도 동향"
    },
    {
      "name": "toss_stock_program_trades",
      "description": "종목 프로그램매매 동향"
    },
    {
      "name": "toss_sector_rankings",
      "description": "섹터 랭킹(등락률·거래대금)"
    },
    {
      "name": "toss_stock_rankings",
      "description": "주식 랭킹(거래대금·거래량·등락률)"
    },
    {
      "name": "toss_stock_prices",
      "description": "종목 현재가(국내·미국)"
    },
    {
      "name": "toss_stock_candles",
      "description": "종목 캔들(분봉·일봉)"
    }
  ],
  "user_config": {
    "client_id": {
      "type": "string",
      "title": "Client ID",
      "description": "토스증권 WTS > 설정 > Open API 의 client_id",
      "sensitive": true,
      "required": true
    },
    "client_secret": {
      "type": "string",
      "title": "Client Secret",
      "description": "토스증권 WTS > 설정 > Open API 의 client_secret",
      "sensitive": true,
      "required": true
    }
  },
  "compatibility": {
    "platforms": [
      "darwin",
      "win32"
    ],
    "runtimes": {
      "node": ">=18.0.0"
    }
  }
}