# 키 이름만 적어 둔 예시입니다. 실제 값은 .env(커밋 안 됨)나 에이전트 설정의 env에 넣으세요.
# 맥에서는 키체인에 넣어 두면 비워도 됩니다.
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=
DART_API_KEY=
ECOS_API_KEY=
# KRX는 인증키 승인 뒤 API마다 활용 신청도 따로 승인받아야 함 (openapi.krx.co.kr)
KRX_API_KEY=
# FRED 키: https://fredaccount.stlouisfed.org/apikeys (32자리 영문 소문자·숫자)
FRED_API_KEY=
# SEC는 키가 없고 연락처가 든 User-Agent를 요구함. 예: 홍길동 me@example.com (이메일은 커밋 금지)
SEC_USER_AGENT=
